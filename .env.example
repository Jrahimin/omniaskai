# Server-only APE configuration. Never prefix these with NEXT_PUBLIC_.
APE_BASE_URL=https://api.omniaskai.com
APE_ORG_KEY=

# 32-byte key as 64 hex characters. Generate with: openssl rand -hex 32
APE_CONVERSATION_TOKEN_KEY=

# PostgreSQL for OmniAskAI product data. Never point this at the APE database.
DATABASE_URL=postgres://omniaskai:omniaskai@localhost:5432/omniaskai
# DATABASE_POOL_MAX=10

# Isolated PostgreSQL used only by `npm run test:integration`.
# The database name must end with `_test`. Never point this at DATABASE_URL.
# TEST_DATABASE_URL=postgres://omniaskai:omniaskai@localhost:5432/omniaskai_test

# Used only by seed/bootstrap to attach APE projects to the four legacy topics.
# Runtime conversation execution reads mappings from PostgreSQL, not these variables.
APE_PROJECT_INCOME_TAX=
APE_PROJECT_LITERATURE=
APE_PROJECT_BANGLADESH_HISTORY=
APE_PROJECT_MOVIES_CULTURE=

# Public origin for trusted cookies. Example: http://localhost:3011
APP_ORIGIN=http://localhost:3011

# Better Auth secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Persistent directory for uploaded topic artwork. Keep it outside app releases.
MEDIA_STORAGE_DIR=./storage/media
